# Cursor CLI agent path (must be on PATH, or provide absolute path)
CURSOR_AGENT_PATH=agent

# Authentication (pick one)
CURSOR_API_KEY=
CURSOR_AUTH_TOKEN=

# API endpoint (optional, leave empty for default)
CURSOR_ENDPOINT=

# Model to use (default: composer-1.5). Run `agent --list-models` for options.
CURSOR_MODEL=composer-1.5

# Default session mode: agent / plan / ask
CURSOR_DEFAULT_MODE=agent

# Permission auto-approval policy: approve-all / approve-reads / deny-all
CURSOR_PERMISSION_MODE=approve-all

# Idle process reclaim timeout (minutes)
CURSOR_IDLE_TTL_MINUTES=30

# Maximum concurrent Cursor agent processes
CURSOR_MAX_SESSIONS=4
